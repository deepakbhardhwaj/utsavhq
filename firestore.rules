rules_version = '2';

// ============================================================================
// UTSAVhq ERP - Cloud Firestore security rules
// STEP 2b: per-workspace isolation, fixed
//
// WHY THIS VERSION EXISTS:
//   The previous version checked membership against users/{email}.companies.
//   A user can write their own user document, so that array could be
//   self-granted: anyone could add a company id to their own array and then
//   read (or rewrite) that workspace. That was a real hole.
//
//   Membership is now proven from a flat array on the company document:
//
//       companies/{companyId}.memberEmails = ["owner@x.com", "staff@y.com"]
//
//   The company document is only writable by its members, so this cannot be
//   self-granted. The app derives and writes memberEmails whenever staff
//   changes (owner + every staff entry with status "Approved").
//
// ACCESS MODEL:
//   companies/{companyId}       -> workspace record + memberEmails[]
//   workspace_data/{companyId}  -> all business data of that workspace
//   users/{email}               -> the user's own record
//   push_subscriptions/{docId}  -> web-push endpoints, each carrying its email
//
// HOW TO PUBLISH:
//   Firebase Console > Firestore Database > Rules > paste > Publish
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Only a VERIFIED email counts. Email-link and Google sign-in both set
    // email_verified = true, so this blocks a spoofed / unverified address
    // from ever matching an ownerEmail or a memberEmails entry.
    function myEmail() {
      return (request.auth != null && request.auth.token.email_verified == true)
        ? request.auth.token.email
        : null;
    }

    // the caller owns this workspace
    function isOwner(companyId) {
      let c = get(/databases/$(database)/documents/companies/$(companyId)).data;
      return signedIn() && c.ownerEmail == myEmail();
    }

    // owner, or an approved member listed in the flat memberEmails array
    function isMember(companyId) {
      let c = get(/databases/$(database)/documents/companies/$(companyId)).data;
      return signedIn() && (
        c.ownerEmail == myEmail() ||
        (c.memberEmails != null && myEmail() in c.memberEmails)
      );
    }

    // ---- business data: members of that workspace only --------------------
    match /workspace_data/{companyId} {
      allow read, write: if isMember(companyId);
    }

    // ---- workspace records ------------------------------------------------
    // Members only. The app reads the caller's own workspaces (their ids come
    // from users/{email}.companies) and joins go through join_codes, so nobody
    // can list or harvest other workspaces, their contacts or their join codes.
    match /companies/{companyId} {
      // resource-based (not get-based) so the two discovery queries in the app
      // - where ownerEmail == me  and  where memberEmails contains me - can be
      // verified by the rules engine.
      allow read: if signedIn() && (
        resource.data.ownerEmail == myEmail() ||
        (resource.data.memberEmails != null && myEmail() in resource.data.memberEmails)
      );

      // the creator becomes the first member
      allow create: if signedIn()
        && request.resource.data.ownerEmail == myEmail()
        && request.resource.data.memberEmails == [myEmail()];

      // 1) the owner may change anything, except handing the workspace away
      allow update: if isOwner(companyId)
          && request.resource.data.ownerEmail == resource.data.ownerEmail
        // 2) other members may edit the workspace, but must NOT be able to
        //    change memberEmails (otherwise they could add or remove people)
        || (isMember(companyId)
            && request.resource.data.ownerEmail == resource.data.ownerEmail
            && request.resource.data.memberEmails == resource.data.memberEmails)
        // 3) an applicant may append ONE staff entry, and only by proving they
        //    know this workspace's join code. They cannot touch memberEmails,
        //    ownerEmail or anything else, so they cannot let themselves in.
        || (signedIn()
            && resource.data.joinCode != null
            && request.resource.data.lastJoinCode == resource.data.joinCode
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['staff', 'lastJoinCode'])
            && request.resource.data.staff.size() == resource.data.staff.size() + 1);

      // only the owner can delete the workspace
      allow delete: if isOwner(companyId);
    }

    // ---- join-code index --------------------------------------------------
    // A tiny public index: { code -> companyId }. It holds NO personal data.
    // Staff resolve a code they were given without being able to list every
    // workspace. Only the workspace owner may publish or change a code.
    match /join_codes/{code} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        get(/databases/$(database)/documents/companies/$(request.resource.data.companyId)).data.ownerEmail == myEmail();
      allow update, delete: if signedIn() &&
        get(/databases/$(database)/documents/companies/$(resource.data.companyId)).data.ownerEmail == myEmail();
    }

    // ---- one document per person, keyed by email -------------------------
    match /users/{docId} {
      allow read, write: if signedIn()
        && (docId == myEmail() || docId == request.auth.token.phone_number);
    }

    // ---- web-push endpoints: only their owner may read or change them -----
    match /push_subscriptions/{docId} {
      allow create, update: if signedIn() && request.resource.data.email == myEmail();
      allow read, delete: if signedIn() && resource.data.email == myEmail();
    }

    // ---- digital visiting cards ------------------------------------------
    // cards/{username} is the PUBLIC card page. The username IS the document
    // id, so uniqueness is enforced by Firestore itself - a create fails when
    // the name is already taken. Anyone may READ a card: that is exactly what
    // makes the shareable link work, and the owner only ever publishes what
    // they chose to show.
    //
    // Ownership is NOT stored in the public card (it would leak the owner's
    // email). It lives in card_owners/{username}, which only its owner can
    // read or write. A card can therefore never be handed to another person.
    match /card_owners/{username} {
      allow read: if signedIn() && resource.data.ownerEmail == myEmail();
      allow create: if signedIn() && request.resource.data.ownerEmail == myEmail();
      allow update, delete: if signedIn() && resource.data.ownerEmail == myEmail();
    }

    match /cards/{username} {
      allow read: if true;
      allow create, update, delete: if signedIn()
        && exists(/databases/$(database)/documents/card_owners/$(username))
        && get(/databases/$(database)/documents/card_owners/$(username)).data.ownerEmail == myEmail();
    }

    // ---- everything else is denied ---------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// ============================================================================
// ROLLBACK
// If something stops working, paste the earlier rules back and investigate:
//
//   match /workspace_data/{docId} { allow read, write: if request.auth != null; }
//   match /companies/{docId}      { allow read, write: if request.auth != null; }
//   match /users/{docId}          { allow read, write: if request.auth != null && docId == request.auth.token.email; }
//   match /push_subscriptions/{docId} { allow read, write: if request.auth != null; }
//   match /{document=**} { allow read, write: if false; }
//
// NOTE ON OLDER WORKSPACES
//   Workspaces created before memberEmails existed have no such field. For
//   those, isMember() still returns true for the owner (via ownerEmail), and
//   the app writes memberEmails the next time the owner opens the workspace
//   or changes the team. Approved staff of such a workspace regain access at
//   that point.
// ============================================================================
