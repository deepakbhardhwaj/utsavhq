rules_version = '2';

// ============================================================================
// UTSAVhq ERP - Cloud Firestore security rules
// STEP 2b: per-workspace isolation, fixed
//
// WHY THIS VERSION EXISTS:
//   The previous version checked membership against users/{email}.companies.
//   A user can write their own user document, so that array could be
//   self-granted: anyone could add a company id to their own array and then
//   read (or rewrite) that workspace. That was a real hole.
//
//   Membership is now proven from a flat array on the company document:
//
//       companies/{companyId}.memberEmails = ["owner@x.com", "staff@y.com"]
//
//   The company document is only writable by its members, so this cannot be
//   self-granted. The app derives and writes memberEmails whenever staff
//   changes (owner + every staff entry with status "Approved").
//
// ACCESS MODEL:
//   companies/{companyId}       -> workspace record + memberEmails[]
//   workspace_data/{companyId}  -> all business data of that workspace
//   users/{email}               -> the user's own record
//   push_subscriptions/{docId}  -> web-push endpoints, each carrying its email
//
// HOW TO PUBLISH:
//   Firebase Console > Firestore Database > Rules > paste > Publish
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myEmail() {
      return request.auth.token.email;
    }

    // owner, or an approved member listed in the flat memberEmails array
    function isMember(companyId) {
      let c = get(/databases/$(database)/documents/companies/$(companyId)).data;
      return signedIn() && (
        c.ownerEmail == myEmail() ||
        (c.memberEmails != null && myEmail() in c.memberEmails)
      );
    }

    // ---- business data: members of that workspace only --------------------
    match /workspace_data/{companyId} {
      allow read, write: if isMember(companyId);
    }

    // ---- workspace records ------------------------------------------------
    // Read stays open to signed-in users: the app lists the workspaces and
    // also looks one up by joinCode when a staff member joins. No business
    // data lives in this collection.
    match /companies/{companyId} {
      allow read: if signedIn();

      // the creator becomes the first member
      allow create: if signedIn()
        && request.resource.data.ownerEmail == myEmail()
        && request.resource.data.memberEmails == [myEmail()];

      // a member may edit the workspace but never hand it to someone else
      allow update: if isMember(companyId)
          && request.resource.data.ownerEmail == resource.data.ownerEmail
        // a pending applicant may ONLY append to staff[] and cannot touch
        // memberEmails / ownerEmail, so they cannot let themselves in
        || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['staff'])
            && request.resource.data.staff.size() == resource.data.staff.size() + 1);

      allow delete: if signedIn() && resource.data.ownerEmail == myEmail();
    }

    // ---- one document per person, keyed by email -------------------------
    match /users/{docId} {
      allow read, write: if signedIn()
        && (docId == myEmail() || docId == request.auth.token.phone_number);
    }

    // ---- web-push endpoints: only their owner may read or change them -----
    match /push_subscriptions/{docId} {
      allow create, update: if signedIn() && request.resource.data.email == myEmail();
      allow read, delete: if signedIn() && resource.data.email == myEmail();
    }

    // ---- everything else is denied ---------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// ============================================================================
// ROLLBACK
// If something stops working, paste the earlier rules back and investigate:
//
//   match /workspace_data/{docId} { allow read, write: if request.auth != null; }
//   match /companies/{docId}      { allow read, write: if request.auth != null; }
//   match /users/{docId}          { allow read, write: if request.auth != null && docId == request.auth.token.email; }
//   match /push_subscriptions/{docId} { allow read, write: if request.auth != null; }
//   match /{document=**} { allow read, write: if false; }
//
// NOTE ON OLDER WORKSPACES
//   Workspaces created before memberEmails existed have no such field. For
//   those, isMember() still returns true for the owner (via ownerEmail), and
//   the app writes memberEmails the next time the owner opens the workspace
//   or changes the team. Approved staff of such a workspace regain access at
//   that point.
// ============================================================================
